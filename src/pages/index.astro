---
import '../styles/global.css';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Core Web Vitals Audit Tool | Live Lighthouse &amp; CrUX Analyzer</title>
    <meta
      name="description"
      content="Run a live Core Web Vitals and PageSpeed Insights audit on any public website. Inspect mobile and desktop LCP, INP, CLS, CrUX field data, and prioritized speed bottlenecks."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('cwv-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = stored ? stored === 'dark' : prefersDark;
        document.documentElement.classList.toggle('dark', isDark);
      })();
    </script>
  </head>

  <body class="min-h-screen flex flex-col antialiased relative overflow-x-clip">
    <!-- Subtle Architectural Grid Backdrop -->
    <div class="cwv-grid-bg pointer-events-none fixed inset-x-0 top-0 h-[520px] opacity-45 z-0" aria-hidden="true"></div>

    <!-- Top Header -->
    <header class="sticky top-0 z-30 border-b border-[var(--border-subtle)] bg-[var(--bg-canvas)]/90 backdrop-blur-md">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
        <a href="/cwv-audit" class="inline-flex items-center gap-2.5 font-extrabold tracking-tight text-base sm:text-lg">
          <svg class="w-8 h-8 shrink-0" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <rect width="64" height="64" rx="14" fill="#111111" />
            <rect x="4" y="4" width="56" height="56" rx="11" stroke="#FACC15" stroke-width="3.5" />
            <path d="M18 42L27 24L35 35L46 18" stroke="#FACC15" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="46" cy="18" r="4.5" fill="#FACC15" />
          </svg>
          <span>CWV Audit Tool</span>
        </a>

        <div class="flex items-center gap-3">
          <a
            href="https://kiranm.in/"
            class="hidden sm:inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
          >
            <span>&larr; Portfolio</span>
          </a>

          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle color theme"
            class="px-3 py-1.5 rounded-[7px] border border-[var(--border-strong)] bg-[var(--bg-surface-elevated)] text-xs font-mono font-semibold text-[var(--text-primary)] hover:bg-[var(--tactile-accent)] hover:text-[#111111] transition-colors cursor-pointer"
          >
            <span id="theme-label">Light Mode</span>
          </button>
        </div>
      </div>
    </header>

    <main class="relative z-10 flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-10 sm:py-14 space-y-10">
      <!-- Centered Hero & Audit Form -->
      <section class="max-w-3xl mx-auto text-center space-y-6">
        <div class="space-y-3.5">
          <p class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[11px] font-mono font-semibold uppercase tracking-[0.12em] text-[var(--text-secondary)]">
            <span class="w-2 h-2 rounded-full bg-[var(--tactile-accent)]"></span>
            <span>// LIVE PAGESPEED INSIGHTS &amp; CRUX ANALYZER</span>
          </p>
          <h1 class="text-3xl sm:text-5xl font-extrabold tracking-[-0.03em] leading-[1.08] text-[var(--text-primary)] [text-wrap:balance]">
            Audit your Core Web Vitals in seconds.
          </h1>
          <p class="text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed max-w-xl mx-auto">
            Run a single live Google PageSpeed Insights scan to inspect <strong>Mobile &amp; Desktop</strong> scores, 28-day real-user CrUX field data, and prioritized speed bottlenecks.
          </p>
        </div>

        <form id="audit-form" class="card-tactile p-4 sm:p-5 space-y-3.5 text-left">
          <div class="flex flex-col sm:flex-row gap-3">
            <div class="flex-1 relative">
              <label for="audit-url" class="sr-only">Website URL</label>
              <input
                id="audit-url"
                name="url"
                type="text"
                inputmode="url"
                required
                placeholder="https://example.com"
                class="w-full h-12 px-4 rounded-[8px] border-[1.5px] border-[var(--border-strong)] bg-[var(--bg-canvas)] text-sm sm:text-base font-mono text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--tactile-accent)]"
              />
            </div>

            <button
              id="run-audit-btn"
              type="submit"
              class="btn-tactile h-12 px-6 text-sm whitespace-nowrap shrink-0"
            >
              <span id="run-btn-text">Run Live Audit</span>
              <span aria-hidden="true">&rarr;</span>
            </button>
          </div>

          <!-- Centered Quick Demo Presets -->
          <div class="flex flex-wrap items-center justify-center gap-2 text-xs font-mono text-[var(--text-muted)] pt-0.5">
            <span>Try:</span>
            <button type="button" data-preset="https://kiranm.in" class="preset-btn px-2.5 py-1 rounded-[5px] border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--border-strong)] transition-colors cursor-pointer">
              kiranm.in
            </button>
            <button type="button" data-preset="https://astro.build" class="preset-btn px-2.5 py-1 rounded-[5px] border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--border-strong)] transition-colors cursor-pointer">
              astro.build
            </button>
            <button type="button" data-preset="https://wordpress.org" class="preset-btn px-2.5 py-1 rounded-[5px] border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--border-strong)] transition-colors cursor-pointer">
              wordpress.org
            </button>
          </div>
        </form>

        <!-- Staged Loading State -->
        <div id="audit-loading" class="hidden card-tactile p-6 space-y-4 text-left">
          <div class="flex items-center gap-3">
            <span class="w-3 h-3 rounded-full bg-[var(--tactile-accent)] animate-ping"></span>
            <p id="loading-stage" class="font-mono text-sm font-bold text-[var(--text-primary)]">
              Connecting to Google PageSpeed Insights...
            </p>
          </div>
          <div class="w-full h-2.5 rounded-full bg-[var(--bg-surface)] border border-[var(--border-subtle)] overflow-hidden">
            <div id="loading-bar" class="h-full bg-[var(--tactile-accent)] transition-all duration-700" style="width: 18%;"></div>
          </div>
          <p class="text-xs font-mono text-[var(--text-muted)]">
            Auditing Mobile and Desktop in parallel &mdash; typically takes 10&ndash;25 seconds.
          </p>
        </div>

        <!-- Error State -->
        <div id="audit-error" class="hidden card-tactile p-5 border-rose-500 bg-rose-500/10 text-sm text-rose-600 dark:text-rose-400 font-medium text-left">
        </div>
      </section>

      <!-- Pre-Scan Hero Showcase Card (Home Hero Style) -->
      <section id="preview-showcase" class="max-w-3xl mx-auto">
        <div class="card-tactile p-4 sm:p-6 space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-3 px-3 py-2.5 rounded-[8px] border border-[var(--border-subtle)] bg-[var(--bg-canvas)]">
            <div class="flex items-center gap-2 font-mono text-xs font-bold tracking-[0.08em] text-[var(--text-primary)]">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
              <span>SAMPLE BENCHMARK</span>
            </div>
            <div class="inline-flex items-center gap-1.5 text-[11px] font-mono text-[var(--text-muted)]">
              <span>Enter a URL above or click a preset to run a live scan</span>
            </div>
          </div>

          <div class="p-4 sm:p-5 rounded-[8px] border border-[var(--border-subtle)] bg-[var(--bg-canvas)] space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-5 items-center">
              <!-- Circular Ring -->
              <div class="sm:col-span-4 flex flex-col items-center justify-center p-4 rounded-[8px] border border-[var(--border-subtle)] bg-[var(--bg-surface)]">
                <div class="relative w-24 h-24 flex items-center justify-center">
                  <svg class="w-full h-full -rotate-90" viewBox="0 0 100 100" aria-hidden="true">
                    <circle cx="50" cy="50" r="42" stroke="currentColor" stroke-width="8" fill="none" class="text-[var(--border-subtle)]" />
                    <circle cx="50" cy="50" r="42" stroke="#10b981" stroke-width="8" fill="none" stroke-linecap="round" stroke-dasharray="263.89" stroke-dashoffset="2.64" />
                  </svg>
                  <div class="absolute inset-0 flex flex-col items-center justify-center">
                    <span class="text-2xl font-extrabold text-[var(--text-primary)] leading-none">99</span>
                    <span class="text-[9px] font-mono uppercase tracking-[0.12em] text-[var(--text-muted)] mt-1">MOBILE</span>
                  </div>
                </div>
              </div>

              <!-- LCP / INP / CLS + Payload -->
              <div class="sm:col-span-8 space-y-3">
                <div class="grid grid-cols-3 gap-2.5 font-mono">
                  <div class="p-3 rounded-[7px] border border-[var(--border-subtle)] bg-[var(--bg-surface)]">
                    <span class="block text-[10px] text-[var(--text-muted)] uppercase">LCP</span>
                    <span class="text-base sm:text-lg font-extrabold text-emerald-500">0.7s</span>
                  </div>
                  <div class="p-3 rounded-[7px] border border-[var(--border-subtle)] bg-[var(--bg-surface)]">
                    <span class="block text-[10px] text-[var(--text-muted)] uppercase">INP</span>
                    <span class="text-base sm:text-lg font-extrabold text-emerald-500">42ms</span>
                  </div>
                  <div class="p-3 rounded-[7px] border border-[var(--border-subtle)] bg-[var(--bg-surface)]">
                    <span class="block text-[10px] text-[var(--text-muted)] uppercase">CLS</span>
                    <span class="text-base sm:text-lg font-extrabold text-emerald-500">0.00</span>
                  </div>
                </div>

                <div class="p-3 rounded-[7px] border border-[var(--border-subtle)] bg-[var(--bg-surface)] space-y-2">
                  <div class="flex items-center justify-between text-xs font-mono">
                    <span class="text-[var(--text-muted)]">Payload</span>
                    <span class="font-bold text-[var(--text-primary)]">240 KB &middot; 9 requests</span>
                  </div>
                  <div class="w-full h-1.5 rounded-full bg-[var(--bg-canvas)] overflow-hidden">
                    <div class="h-full bg-emerald-500 rounded-full" style="width: 24%;"></div>
                  </div>
                </div>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2 border-t border-[var(--border-subtle)] font-mono text-xs text-[var(--text-secondary)]">
              <div class="flex items-center gap-2 px-3 py-2 rounded-[6px] border border-[var(--border-subtle)] bg-[var(--bg-surface)]">
                <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
                <span>28-Day CrUX Field Data</span>
              </div>
              <div class="flex items-center gap-2 px-3 py-2 rounded-[6px] border border-[var(--border-subtle)] bg-[var(--bg-surface)]">
                <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
                <span>Parallel Mobile + Desktop</span>
              </div>
              <div class="flex items-center gap-2 px-3 py-2 rounded-[6px] border border-[var(--border-subtle)] bg-[var(--bg-surface)]">
                <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
                <span>Savings Ranked (ms &amp; KB)</span>
              </div>
              <div class="flex items-center gap-2 px-3 py-2 rounded-[6px] border border-[var(--border-subtle)] bg-[var(--bg-surface)]">
                <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
                <span>Markdown &amp; JSON Export</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Live Results Dashboard -->
      <section id="audit-results" class="hidden space-y-8 max-w-4xl mx-auto">
        <!-- Hero-Style Summary Card -->
        <div class="card-tactile p-4 sm:p-6 space-y-4">
          <!-- Top Bar: URL + Device Switcher + Export -->
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 px-3.5 py-3 rounded-[8px] border border-[var(--border-subtle)] bg-[var(--bg-canvas)]">
            <div class="min-w-0 space-y-0.5">
              <div class="flex items-center gap-2 font-mono text-[11px] font-bold uppercase tracking-[0.08em] text-[var(--text-muted)]">
                <span id="res-status-dot" class="w-2.5 h-2.5 rounded-full bg-emerald-500 shrink-0"></span>
                <span>CWV AUDIT &middot; <span id="res-strategy" class="text-[var(--text-primary)]">MOBILE</span></span>
                <span>&middot;</span>
                <span id="res-time"></span>
              </div>
              <h2 id="res-url" class="text-sm sm:text-base font-extrabold font-mono text-[var(--text-primary)] truncate"></h2>
            </div>

            <div class="flex flex-wrap items-center gap-2 shrink-0">
              <div
                role="tablist"
                aria-label="Switch device view"
                class="inline-flex p-1 rounded-[7px] border border-[var(--border-strong)] bg-[var(--bg-surface)]"
              >
                <button
                  id="tab-mobile"
                  type="button"
                  role="tab"
                  data-view="mobile"
                  aria-selected="true"
                  class="view-tab inline-flex items-center gap-1.5 px-3 py-1 rounded-[5px] text-xs font-mono font-bold transition-colors bg-[var(--tactile-accent)] text-[#111111] cursor-pointer"
                >
                  <span>Mobile</span>
                  <span id="tab-mobile-score" class="px-1.5 py-0.5 rounded-[4px] bg-black/15 text-[10px]">—</span>
                </button>
                <button
                  id="tab-desktop"
                  type="button"
                  role="tab"
                  data-view="desktop"
                  aria-selected="false"
                  class="view-tab inline-flex items-center gap-1.5 px-3 py-1 rounded-[5px] text-xs font-mono font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors cursor-pointer"
                >
                  <span>Desktop</span>
                  <span id="tab-desktop-score" class="px-1.5 py-0.5 rounded-[4px] bg-[var(--bg-canvas)] text-[10px]">—</span>
                </button>
              </div>

              <button
                id="copy-md-btn"
                type="button"
                class="px-3 py-1.5 rounded-[7px] border border-[var(--border-strong)] bg-[var(--bg-surface-elevated)] text-xs font-mono font-bold text-[var(--text-primary)] hover:bg-[var(--tactile-accent)] hover:text-[#111111] transition-colors cursor-pointer"
              >
                Copy MD
              </button>
              <button
                id="download-json-btn"
                type="button"
                class="px-3 py-1.5 rounded-[7px] border border-[var(--border-strong)] bg-[var(--bg-surface-elevated)] text-xs font-mono font-bold text-[var(--text-primary)] hover:bg-[var(--tactile-accent)] hover:text-[#111111] transition-colors cursor-pointer"
              >
                JSON
              </button>
            </div>
          </div>

          <!-- Signature Score Ring + LCP/INP/CLS + Payload -->
          <div class="p-4 sm:p-5 rounded-[8px] border border-[var(--border-subtle)] bg-[var(--bg-canvas)] space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-5 items-center">
              <div class="sm:col-span-4 flex flex-col items-center justify-center p-4 rounded-[8px] border border-[var(--border-subtle)] bg-[var(--bg-surface)]">
                <div class="relative w-28 h-28 flex items-center justify-center">
                  <svg class="w-full h-full -rotate-90" viewBox="0 0 100 100" aria-hidden="true">
                    <circle cx="50" cy="50" r="42" stroke="currentColor" stroke-width="8" fill="none" class="text-[var(--border-subtle)]" />
                    <circle
                      id="hero-ring-arc"
                      cx="50"
                      cy="50"
                      r="42"
                      stroke="#10b981"
                      stroke-width="8"
                      fill="none"
                      stroke-linecap="round"
                      stroke-dasharray="263.89"
                      stroke-dashoffset="263.89"
                      class="transition-all duration-700"
                    />
                  </svg>
                  <div class="absolute inset-0 flex flex-col items-center justify-center">
                    <span id="hero-ring-score" class="text-3xl font-extrabold text-[var(--text-primary)] leading-none">—</span>
                    <span id="hero-ring-label" class="text-[10px] font-mono uppercase tracking-[0.12em] text-[var(--text-muted)] mt-1">MOBILE</span>
                  </div>
                </div>
              </div>

              <div class="sm:col-span-8 space-y-3">
                <div id="hero-cwv-tiles" class="grid grid-cols-3 gap-2.5 font-mono"></div>

                <div class="p-3 rounded-[7px] border border-[var(--border-subtle)] bg-[var(--bg-surface)] space-y-2">
                  <div class="flex items-center justify-between text-xs font-mono">
                    <span class="text-[var(--text-muted)]">Total Payload</span>
                    <span id="hero-payload-text" class="font-bold text-[var(--text-primary)]">—</span>
                  </div>
                  <div class="w-full h-1.5 rounded-full bg-[var(--bg-canvas)] overflow-hidden">
                    <div id="hero-payload-bar" class="h-full bg-emerald-500 rounded-full transition-all duration-500" style="width: 0%;"></div>
                  </div>
                </div>
              </div>
            </div>

            <!-- 4 Category Pills -->
            <div id="scores-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 pt-2 border-t border-[var(--border-subtle)]"></div>
          </div>
        </div>

        <!-- Field Data (CrUX) vs Lab Data (Lighthouse) -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div class="card-tactile p-5 sm:p-6 space-y-4">
            <div class="flex items-center justify-between gap-2 pb-3 border-b border-[var(--border-subtle)]">
              <div>
                <h3 class="text-base font-extrabold text-[var(--text-primary)]">Real-User Field Data (CrUX)</h3>
                <p class="text-xs text-[var(--text-muted)]">28-day Chrome UX Report (75th percentile)</p>
              </div>
              <span id="crux-badge" class="px-2.5 py-1 rounded-[5px] text-[11px] font-mono font-bold border"></span>
            </div>
            <div id="crux-metrics" class="space-y-3"></div>
          </div>

          <div class="card-tactile p-5 sm:p-6 space-y-4">
            <div class="flex items-center justify-between gap-2 pb-3 border-b border-[var(--border-subtle)]">
              <div>
                <h3 class="text-base font-extrabold text-[var(--text-primary)]">Lighthouse Lab Diagnostics</h3>
                <p class="text-xs text-[var(--text-muted)]">Controlled synthetic crawl measurements</p>
              </div>
              <span class="px-2.5 py-1 rounded-[5px] text-[11px] font-mono font-bold border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)]">
                SIMULATED
              </span>
            </div>
            <div id="lab-metrics" class="space-y-3"></div>
          </div>
        </div>

        <!-- Top Actionable Opportunities -->
        <div class="card-tactile p-5 sm:p-6 space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-[var(--border-subtle)]">
            <div>
              <h3 class="text-base sm:text-lg font-extrabold text-[var(--text-primary)]">
                Top Speed Bottlenecks &amp; Opportunities
              </h3>
              <p class="text-xs text-[var(--text-muted)]">
                Prioritized by estimated load-time and payload savings
              </p>
            </div>
          </div>
          <div id="opportunities-list" class="divide-y divide-[var(--border-subtle)]"></div>
        </div>

        <!-- Contextual Fix CTA -->
        <div class="card-tactile p-6 sm:p-8 bg-[var(--bg-surface)] flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="space-y-1.5 max-w-xl">
            <p class="text-xs font-mono font-bold uppercase tracking-[0.12em] text-[var(--text-muted)]">
              // NEED HELP FIXING THESE?
            </p>
            <h3 class="text-xl font-extrabold text-[var(--text-primary)]">
              Want 90+ mobile PageSpeed without breaking your theme?
            </h3>
            <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
              I fix LCP, INP, CLS, and script bloat on WordPress, WooCommerce, Shopify, and Astro sites. Copy your Markdown report above and send it over.
            </p>
          </div>
          <a
            href="https://kiranm.in/services/page-speed-optimization"
            class="btn-tactile px-6 py-3 text-sm whitespace-nowrap shrink-0"
          >
            <span>Explore Speed Optimization</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="relative z-10 border-t border-[var(--border-subtle)] py-6 text-center text-xs font-mono text-[var(--text-muted)]">
      Built by <a href="https://kiranm.in/" class="underline hover:text-[var(--text-primary)]">Kiran M.</a> &middot; Powered by Google PageSpeed Insights v5 API
    </footer>

    <script is:inline>
      (() => {
        const themeBtn = document.getElementById('theme-toggle');
        const themeLabel = document.getElementById('theme-label');
        function syncThemeLabel() {
          const isDark = document.documentElement.classList.contains('dark');
          if (themeLabel) themeLabel.textContent = isDark ? 'Light Mode' : 'Dark Mode';
        }
        syncThemeLabel();
        themeBtn?.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('cwv-theme', isDark ? 'dark' : 'light');
          syncThemeLabel();
        });

        const urlInput = document.getElementById('audit-url');
        document.querySelectorAll('.preset-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            if (urlInput) urlInput.value = btn.getAttribute('data-preset') || '';
          });
        });

        const form = document.getElementById('audit-form');
        const runBtn = document.getElementById('run-audit-btn');
        const runBtnText = document.getElementById('run-btn-text');
        const loadingEl = document.getElementById('audit-loading');
        const loadingStage = document.getElementById('loading-stage');
        const loadingBar = document.getElementById('loading-bar');
        const errorEl = document.getElementById('audit-error');
        const previewEl = document.getElementById('preview-showcase');
        const resultsEl = document.getElementById('audit-results');

        let fullPayload = null;
        let activeView = 'mobile';
        let stageTimer = null;

        function setLoading(isLoading) {
          if (runBtn) runBtn.disabled = isLoading;
          if (runBtnText) runBtnText.textContent = isLoading ? 'Auditing...' : 'Run Live Audit';
          loadingEl?.classList.toggle('hidden', !isLoading);

          if (isLoading) {
            errorEl?.classList.add('hidden');
            resultsEl?.classList.add('hidden');
            previewEl?.classList.add('hidden');
            const stages = [
              { text: 'Connecting to Google PageSpeed Insights...', pct: '22%' },
              { text: 'Running Mobile & Desktop Lighthouse simulations...', pct: '55%' },
              { text: 'Checking 28-day CrUX field metrics...', pct: '78%' },
              { text: 'Ranking bottlenecks & savings...', pct: '92%' },
            ];
            let i = 0;
            if (loadingStage) loadingStage.textContent = stages[0].text;
            if (loadingBar) loadingBar.style.width = stages[0].pct;
            stageTimer = setInterval(() => {
              i = Math.min(i + 1, stages.length - 1);
              if (loadingStage) loadingStage.textContent = stages[i].text;
              if (loadingBar) loadingBar.style.width = stages[i].pct;
            }, 3500);
          } else if (stageTimer) {
            clearInterval(stageTimer);
            stageTimer = null;
          }
        }

        function scoreColorHex(score) {
          if (score === null || score === undefined) return '#71717a';
          if (score >= 90) return '#10b981';
          if (score >= 50) return '#f59e0b';
          return '#f43f5e';
        }

        function scoreTextClass(score) {
          if (score === null || score === undefined) return 'text-[var(--text-muted)]';
          if (score >= 90) return 'text-emerald-500';
          if (score >= 50) return 'text-amber-500';
          return 'text-rose-500';
        }

        function scoreBadgeClass(score) {
          if (score === null || score === undefined) return 'text-[var(--text-muted)] border-[var(--border-subtle)] bg-[var(--bg-surface)]';
          if (score >= 90) return 'text-emerald-600 dark:text-emerald-400 border-emerald-500/40 bg-emerald-500/10';
          if (score >= 50) return 'text-amber-600 dark:text-amber-400 border-amber-500/40 bg-amber-500/10';
          return 'text-rose-600 dark:text-rose-400 border-rose-500/40 bg-rose-500/10';
        }

        function fieldBadgeClass(cat) {
          if (cat === 'FAST') return 'text-emerald-600 dark:text-emerald-400 border-emerald-500/40 bg-emerald-500/10';
          if (cat === 'AVERAGE') return 'text-amber-600 dark:text-amber-400 border-amber-500/40 bg-amber-500/10';
          if (cat === 'SLOW') return 'text-rose-600 dark:text-rose-400 border-rose-500/40 bg-rose-500/10';
          return 'text-[var(--text-muted)] border-[var(--border-subtle)] bg-[var(--bg-surface)]';
        }

        function escapeHtml(str) {
          return String(str ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
        }

        function syncTabs() {
          const mobileScore = fullPayload?.mobile?.scores?.performance;
          const desktopScore = fullPayload?.desktop?.scores?.performance;
          const mBadge = document.getElementById('tab-mobile-score');
          const dBadge = document.getElementById('tab-desktop-score');
          if (mBadge) mBadge.textContent = mobileScore ?? 'N/A';
          if (dBadge) dBadge.textContent = desktopScore ?? 'N/A';

          document.querySelectorAll('.view-tab').forEach((tab) => {
            const view = tab.getAttribute('data-view');
            const isSelected = view === activeView;
            const isDisabled = !fullPayload?.[view];
            tab.disabled = isDisabled;
            tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
            tab.className = isSelected
              ? 'view-tab inline-flex items-center gap-1.5 px-3 py-1 rounded-[5px] text-xs font-mono font-bold transition-colors bg-[var(--tactile-accent)] text-[#111111] cursor-pointer'
              : 'view-tab inline-flex items-center gap-1.5 px-3 py-1 rounded-[5px] text-xs font-mono font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors cursor-pointer disabled:opacity-40';
          });
        }

        function renderActiveView() {
          if (!fullPayload) return;
          const data = fullPayload[activeView] || fullPayload.mobile || fullPayload.desktop;
          if (!data) return;

          syncTabs();

          const perf = data.scores?.performance;
          document.getElementById('res-strategy').textContent = activeView.toUpperCase();
          document.getElementById('res-url').textContent = data.finalUrl || data.auditedUrl;
          document.getElementById('res-time').textContent = new Date(data.fetchTime).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

          const statusDot = document.getElementById('res-status-dot');
          if (statusDot) {
            statusDot.className = `w-2.5 h-2.5 rounded-full shrink-0 ${
              perf === null ? 'bg-zinc-500' : perf >= 90 ? 'bg-emerald-500' : perf >= 50 ? 'bg-amber-500' : 'bg-rose-500'
            }`;
          }

          // Hero Circular Score Ring
          const circumference = 263.89;
          const arc = document.getElementById('hero-ring-arc');
          const ringScore = document.getElementById('hero-ring-score');
          const ringLabel = document.getElementById('hero-ring-label');
          if (arc) {
            const pct = typeof perf === 'number' ? Math.max(0, Math.min(100, perf)) : 0;
            arc.style.stroke = scoreColorHex(perf);
            arc.style.strokeDashoffset = String(circumference * (1 - pct / 100));
          }
          if (ringScore) ringScore.textContent = perf ?? '—';
          if (ringLabel) ringLabel.textContent = activeView.toUpperCase();

          // Hero 3 CWV Tiles (LCP, INP or TBT, CLS)
          const cwvTiles = document.getElementById('hero-cwv-tiles');
          if (cwvTiles) {
            const lcpVal = data.fieldData?.lcp?.displayValue || data.labData?.lcp?.displayValue || '—';
            const lcpColor = data.fieldData?.lcp
              ? (data.fieldData.lcp.category === 'FAST' ? 'text-emerald-500' : data.fieldData.lcp.category === 'AVERAGE' ? 'text-amber-500' : 'text-rose-500')
              : scoreTextClass(typeof data.labData?.lcp?.score === 'number' ? Math.round(data.labData.lcp.score * 100) : null);

            const hasInp = Boolean(data.fieldData?.inp);
            const respLabel = hasInp ? 'INP' : 'TBT (LAB)';
            const respVal = hasInp ? data.fieldData.inp.displayValue : (data.labData?.tbt?.displayValue || '—');
            const respColor = hasInp
              ? (data.fieldData.inp.category === 'FAST' ? 'text-emerald-500' : data.fieldData.inp.category === 'AVERAGE' ? 'text-amber-500' : 'text-rose-500')
              : scoreTextClass(typeof data.labData?.tbt?.score === 'number' ? Math.round(data.labData.tbt.score * 100) : null);

            const clsVal = data.fieldData?.cls?.displayValue || data.labData?.cls?.displayValue || '—';
            const clsColor = data.fieldData?.cls
              ? (data.fieldData.cls.category === 'FAST' ? 'text-emerald-500' : data.fieldData.cls.category === 'AVERAGE' ? 'text-amber-500' : 'text-rose-500')
              : scoreTextClass(typeof data.labData?.cls?.score === 'number' ? Math.round(data.labData.cls.score * 100) : null);

            cwvTiles.innerHTML = [
              { label: 'LCP', val: lcpVal, color: lcpColor },
              { label: respLabel, val: respVal, color: respColor },
              { label: 'CLS', val: clsVal, color: clsColor },
            ]
              .map(
                (t) => `
                <div class="p-3 rounded-[7px] border border-[var(--border-subtle)] bg-[var(--bg-surface)]">
                  <span class="block text-[10px] text-[var(--text-muted)] uppercase">${t.label}</span>
                  <span class="text-base sm:text-lg font-extrabold ${t.color}">${escapeHtml(t.val)}</span>
                </div>
              `,
              )
              .join('');
          }

          // Hero Payload Bar
          const kb = data.payload?.totalKb;
          const reqs = data.payload?.requestCount;
          const payloadText = document.getElementById('hero-payload-text');
          const payloadBar = document.getElementById('hero-payload-bar');
          if (payloadText) {
            const parts = [];
            if (typeof kb === 'number') parts.push(`${kb.toLocaleString()} KB`);
            if (typeof reqs === 'number') parts.push(`${reqs} requests`);
            payloadText.textContent = parts.length ? parts.join(' · ') : '—';
          }
          if (payloadBar) {
            const widthPct = typeof kb === 'number' ? Math.min(100, Math.max(8, Math.round((kb / 2500) * 100))) : 20;
            const color = typeof kb === 'number' ? (kb <= 800 ? 'bg-emerald-500' : kb <= 1800 ? 'bg-amber-500' : 'bg-rose-500') : 'bg-zinc-500';
            payloadBar.className = `h-full ${color} rounded-full transition-all duration-500`;
            payloadBar.style.width = `${widthPct}%`;
          }

          // 4 Category Pills
          const scoreDefs = [
            { key: 'performance', label: 'Performance' },
            { key: 'accessibility', label: 'Accessibility' },
            { key: 'bestPractices', label: 'Best Practices' },
            { key: 'seo', label: 'SEO' },
          ];
          const scoresGrid = document.getElementById('scores-grid');
          if (scoresGrid) {
            scoresGrid.innerHTML = scoreDefs
              .map(({ key, label }) => {
                const val = data.scores?.[key];
                const dot = val === null ? 'bg-zinc-500' : val >= 90 ? 'bg-emerald-500' : val >= 50 ? 'bg-amber-500' : 'bg-rose-500';
                return `
                  <div class="flex items-center justify-between gap-2 px-3 py-2 rounded-[6px] border border-[var(--border-subtle)] bg-[var(--bg-surface)] font-mono text-xs">
                    <span class="flex items-center gap-2 text-[var(--text-secondary)]">
                      <span class="w-2 h-2 rounded-full ${dot} shrink-0"></span>
                      <span>${label}</span>
                    </span>
                    <span class="font-bold text-[var(--text-primary)]">${val ?? '—'}</span>
                  </div>
                `;
              })
              .join('');
          }

          // CrUX Field Data
          const cruxBadge = document.getElementById('crux-badge');
          const cruxEl = document.getElementById('crux-metrics');
          const overall = data.fieldData?.overallCategory;
          if (cruxBadge) {
            cruxBadge.textContent = overall || 'NO FIELD DATA';
            cruxBadge.className = `px-2.5 py-1 rounded-[5px] text-[11px] font-mono font-bold border ${fieldBadgeClass(overall)}`;
          }
          if (cruxEl) {
            if (!data.fieldData?.hasData) {
              cruxEl.innerHTML = `<p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed py-4">Not enough 28-day real-user Chrome traffic for ${activeView} CrUX field data on this URL. Use the Lighthouse Lab metrics on the right instead.</p>`;
            } else {
              const fieldRows = [
                { label: 'Largest Contentful Paint (LCP)', item: data.fieldData.lcp },
                { label: 'Interaction to Next Paint (INP)', item: data.fieldData.inp },
                { label: 'Cumulative Layout Shift (CLS)', item: data.fieldData.cls },
                { label: 'First Contentful Paint (FCP)', item: data.fieldData.fcp },
                { label: 'Time to First Byte (TTFB)', item: data.fieldData.ttfb },
              ].filter((r) => r.item);

              cruxEl.innerHTML = fieldRows
                .map(
                  (r) => `
                  <div class="flex items-center justify-between gap-3 py-2 border-b border-[var(--border-subtle)] last:border-b-0">
                    <span class="text-xs sm:text-sm font-medium text-[var(--text-secondary)]">${r.label}</span>
                    <div class="flex items-center gap-2 shrink-0">
                      <span class="font-mono text-xs sm:text-sm font-bold text-[var(--text-primary)]">${escapeHtml(r.item.displayValue)}</span>
                      <span class="px-2 py-0.5 rounded-[4px] border text-[10px] font-mono font-bold ${fieldBadgeClass(r.item.category)}">${escapeHtml(r.item.category)}</span>
                    </div>
                  </div>
                `,
                )
                .join('');
            }
          }

          // Lab Metrics
          const labEl = document.getElementById('lab-metrics');
          if (labEl) {
            const labRows = [
              data.labData?.lcp,
              data.labData?.tbt,
              data.labData?.cls,
              data.labData?.fcp,
              data.labData?.si,
              data.labData?.ttfb,
            ].filter(Boolean);

            labEl.innerHTML = labRows
              .map((m) => {
                const pct = typeof m.score === 'number' ? Math.round(m.score * 100) : null;
                return `
                  <div class="flex items-center justify-between gap-3 py-2 border-b border-[var(--border-subtle)] last:border-b-0">
                    <span class="text-xs sm:text-sm font-medium text-[var(--text-secondary)]">${escapeHtml(m.title)}</span>
                    <span class="px-2.5 py-0.5 rounded-[4px] border text-xs font-mono font-bold ${scoreBadgeClass(pct)}">
                      ${escapeHtml(m.displayValue)}
                    </span>
                  </div>
                `;
              })
              .join('');
          }

          // Opportunities
          const oppEl = document.getElementById('opportunities-list');
          if (oppEl) {
            if (!data.opportunities || data.opportunities.length === 0) {
              oppEl.innerHTML = `<p class="text-sm text-emerald-600 dark:text-emerald-400 font-semibold py-4">No major Lighthouse speed bottlenecks detected on ${activeView}.</p>`;
            } else {
              oppEl.innerHTML = data.opportunities
                .map((op) => {
                  const savings = [];
                  if (op.savingsMs > 0) savings.push(`${op.savingsMs} ms`);
                  if (op.savingsBytes > 0) savings.push(`${Math.round(op.savingsBytes / 1024)} KB`);
                  if (op.displayValue) savings.push(op.displayValue);
                  const badge = savings[0] || 'Needs review';
                  return `
                    <div class="py-4 space-y-1.5">
                      <div class="flex flex-wrap items-center justify-between gap-2">
                        <h4 class="text-sm font-bold text-[var(--text-primary)]">${escapeHtml(op.title)}</h4>
                        <span class="px-2 py-0.5 rounded-[4px] border border-amber-500/40 bg-amber-500/10 text-amber-600 dark:text-amber-400 text-xs font-mono font-bold">
                          ${escapeHtml(badge)}
                        </span>
                      </div>
                      <p class="text-xs text-[var(--text-secondary)] leading-relaxed">${escapeHtml(op.description)}</p>
                    </div>
                  `;
                })
                .join('');
            }
          }

          resultsEl?.classList.remove('hidden');
        }

        document.querySelectorAll('.view-tab').forEach((tab) => {
          tab.addEventListener('click', () => {
            const view = tab.getAttribute('data-view');
            if (!view || !fullPayload?.[view]) return;
            activeView = view;
            renderActiveView();
          });
        });

        form?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const targetUrl = urlInput?.value?.trim();
          if (!targetUrl) return;

          setLoading(true);
          try {
            const res = await fetch('/api/audit', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ url: targetUrl, strategy: 'both' }),
            });
            const data = await res.json();
            if (!res.ok) {
              throw new Error(data.error || `Request failed (${res.status})`);
            }
            fullPayload = data;
            activeView = data.mobile ? 'mobile' : 'desktop';
            renderActiveView();
          } catch (err) {
            if (errorEl) {
              errorEl.textContent = err instanceof Error ? err.message : 'Unable to complete audit.';
              errorEl.classList.remove('hidden');
            }
            previewEl?.classList.remove('hidden');
          } finally {
            setLoading(false);
          }
        });

        document.getElementById('copy-md-btn')?.addEventListener('click', async (e) => {
          if (!fullPayload) return;
          const formatBlock = (label, d) => {
            if (!d) return `## ${label}\n- Not available\n`;
            return [
              `## ${label}`,
              `- **Performance:** ${d.scores?.performance ?? '—'} | **Accessibility:** ${d.scores?.accessibility ?? '—'} | **Best Practices:** ${d.scores?.bestPractices ?? '—'} | **SEO:** ${d.scores?.seo ?? '—'}`,
              `- **Lab:** LCP ${d.labData?.lcp?.displayValue ?? '—'} · TBT ${d.labData?.tbt?.displayValue ?? '—'} · CLS ${d.labData?.cls?.displayValue ?? '—'} · FCP ${d.labData?.fcp?.displayValue ?? '—'}`,
              ...(d.opportunities || []).slice(0, 5).map((o) => `  - **${o.title}** (${o.savingsMs ? `${o.savingsMs} ms` : o.displayValue || 'check'})`),
            ].join('\n');
          };

          const md = [
            `# CWV Audit Report: ${fullPayload.finalUrl}`,
            '',
            formatBlock('Mobile', fullPayload.mobile),
            '',
            formatBlock('Desktop', fullPayload.desktop),
          ].join('\n');
          await navigator.clipboard.writeText(md);
          const btn = e.currentTarget;
          btn.textContent = 'Copied!';
          setTimeout(() => {
            btn.textContent = 'Copy MD';
          }, 1800);
        });

        document.getElementById('download-json-btn')?.addEventListener('click', () => {
          if (!fullPayload) return;
          const blob = new Blob([JSON.stringify(fullPayload, null, 2)], { type: 'application/json' });
          const a = document.createElement('a');
          a.href = URL.createObjectURL(blob);
          a.download = 'cwv-audit-report.json';
          a.click();
          URL.revokeObjectURL(a.href);
        });
      })();
    </script>
  </body>
</html>
